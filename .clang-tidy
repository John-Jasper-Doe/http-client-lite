---
#Checks:          '-*,clang-diagnostic-*,clang-analyzer-*,-readability-*,concurrency-*,cppcoreguidelines-*'
Checks: >
  clang-analyzer-*,
  modernize-*,
  performance-*,
  readability-*,
  bugprone-*,
  cppcoreguidelines-*,
  -modernize-use-trailing-return-type  # Exclude for check
HeaderFilterRegex: '^include/'
WarningsAsErrors: ''
HeaderFileExtensions: ['', 'h','hh','hpp','hxx']
ImplementationFileExtensions: ['c','cc','cpp','cxx']
# AnalyzeTemporaryDtors: false
FormatStyle:     file
User:            John
CheckOptions:
  modernize-use-nullptr.NullMacros: 'NULL'  # Check for replace 'NULL' on 'nullptr'
  cppcoreguidelines-pro-bounds-pointer-arithmetic: 0
...
