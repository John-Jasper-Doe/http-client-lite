# amalgamate.cmake — groups the library headers into a single header file
# (runs as `cmake -P`; invoked by the add_custom_command in the root
# CMakeLists.txt when HTTP_CLIENT_LITE_AMALGAMATE is ON).
#
# Inputs (passed with -D):
#   HEADER_DIR  — the include tree to amalgamate (…/include)
#   OUTPUT_FILE — where to write the generated header
#
# Algorithm: every header is expanded depth-first; a local quoted include
# ("type_traits.hpp", "../common/common.hpp", …) is replaced in place by the
# expanded content of the referenced header. An already expanded header is
# skipped (the emitted set emulates #pragma once), #pragma once directives
# are stripped and system #include <…> lines are kept as they are. All local
# includes in this project are unconditional, so the result is semantically
# identical to including the individual headers.

cmake_minimum_required (VERSION 3.20)

if (NOT DEFINED HEADER_DIR OR NOT DEFINED OUTPUT_FILE)
  message (FATAL_ERROR
    "amalgamate.cmake: HEADER_DIR and OUTPUT_FILE are required"
  )
endif (NOT DEFINED HEADER_DIR OR NOT DEFINED OUTPUT_FILE)

if (NOT IS_DIRECTORY "${HEADER_DIR}")
  message (FATAL_ERROR "amalgamate.cmake: ${HEADER_DIR} is not a directory")
endif (NOT IS_DIRECTORY "${HEADER_DIR}")

# The emitted/in-progress header sets are shared between the recursive
# invocations of expand_file().
set_property (GLOBAL PROPERTY AMALGAMATED_EMITTED "")
set_property (GLOBAL PROPERTY AMALGAMATED_IN_PROGRESS "")

# expand_file(<path> <out-var>): the expanded content of one header; the
# result is empty when the header has already been emitted elsewhere.
function (expand_file FILEPATH OUT_VAR)
  get_property (IN_PROGRESS GLOBAL PROPERTY AMALGAMATED_IN_PROGRESS)
  if (FILEPATH IN_LIST IN_PROGRESS)
    message (FATAL_ERROR "amalgamate.cmake: include cycle at ${FILEPATH}")
  endif (FILEPATH IN_LIST IN_PROGRESS)

  get_property (EMITTED GLOBAL PROPERTY AMALGAMATED_EMITTED)
  if (FILEPATH IN_LIST EMITTED)
    set (${OUT_VAR} "" PARENT_SCOPE)
    return ()
  endif (FILEPATH IN_LIST EMITTED)
  set_property (GLOBAL APPEND PROPERTY AMALGAMATED_EMITTED "${FILEPATH}")
  set_property (GLOBAL APPEND PROPERTY AMALGAMATED_IN_PROGRESS "${FILEPATH}")

  file (READ "${FILEPATH}" CONTENT)

  # Expand every quoted include in place (the first occurrence wins, like
  # #pragma once: later occurrences are replaced by nothing).
  while (CONTENT MATCHES "#include[ \t]*\"([^\"]+)\"")
    set (FULL_MATCH "${CMAKE_MATCH_0}")
    set (INCLUDED "${CMAKE_MATCH_1}")

    get_filename_component (CURRENT_DIR "${FILEPATH}" DIRECTORY)
    get_filename_component (RESOLVED
      "${INCLUDED}" ABSOLUTE BASE_DIR "${CURRENT_DIR}"
    )
    cmake_path (IS_PREFIX HEADER_DIR "${RESOLVED}" NORMALIZE IS_LOCAL)
    if (NOT IS_LOCAL)
      message (FATAL_ERROR
        "amalgamate.cmake: ${FILEPATH}: include \"${INCLUDED}\" points"
        " outside ${HEADER_DIR}"
      )
    endif (NOT IS_LOCAL)
    if (NOT EXISTS "${RESOLVED}")
      message (FATAL_ERROR
        "amalgamate.cmake: ${FILEPATH}: include \"${INCLUDED}\" not found"
      )
    endif (NOT EXISTS "${RESOLVED}")

    expand_file ("${RESOLVED}" EXPANDED)

    # Replace only the first occurrence: the rest of the content (including
    # the includes of other headers) is re-scanned on the next iteration.
    string (FIND "${CONTENT}" "${FULL_MATCH}" MATCH_POS)
    if (MATCH_POS LESS 0)
      message (FATAL_ERROR
        "amalgamate.cmake: ${FILEPATH}: cannot locate \"${FULL_MATCH}\""
      )
    endif (MATCH_POS LESS 0)
    string (LENGTH "${FULL_MATCH}" MATCH_LEN)
    math (EXPR TAIL_POS "${MATCH_POS} + ${MATCH_LEN}")
    string (SUBSTRING "${CONTENT}" 0 ${MATCH_POS} HEAD)
    string (SUBSTRING "${CONTENT}" ${TAIL_POS} -1 TAIL)
    set (CONTENT "${HEAD}${EXPANDED}${TAIL}")
  endwhile (CONTENT MATCHES "#include[ \t]*\"([^\"]+)\"")

  # The generated file carries a single #pragma once of its own.
  string (REGEX REPLACE "#pragma[ \t]*once" "" CONTENT "${CONTENT}")

  # Leave the cycle guard: this header is fully expanded.
  get_property (IN_PROGRESS GLOBAL PROPERTY AMALGAMATED_IN_PROGRESS)
  list (REMOVE_ITEM IN_PROGRESS "${FILEPATH}")
  set_property (GLOBAL PROPERTY AMALGAMATED_IN_PROGRESS "${IN_PROGRESS}")

  set (${OUT_VAR} "${CONTENT}" PARENT_SCOPE)
endfunction (expand_file)

# The deterministic emission order over the whole tree (every header is
# emitted exactly once, dependencies first via the recursion above).
file (GLOB_RECURSE AMALGAMATED_INPUTS "${HEADER_DIR}/*.hpp")
list (SORT AMALGAMATED_INPUTS)

set (SECTIONS "")
foreach (HEADER IN LISTS AMALGAMATED_INPUTS)
  expand_file ("${HEADER}" HEADER_CONTENT)
  string (APPEND SECTIONS "${HEADER_CONTENT}")
endforeach (HEADER IN LISTS AMALGAMATED_INPUTS)

list (LENGTH AMALGAMATED_INPUTS HEADER_COUNT)
file (WRITE "${OUTPUT_FILE}"
  "/* Generated by cmake/amalgamate.cmake — DO NOT EDIT.\n"
  " * Sources: ${HEADER_COUNT} headers of ${HEADER_DIR}\n"
  " */\n"
  "#pragma once\n"
  "${SECTIONS}"
)
message (STATUS
  "[amalgamate] ${HEADER_COUNT} headers -> ${OUTPUT_FILE}"
)
